{
	"name": "@antithrow/jose",
	"version": "0.0.0",
	"description": "Non-throwing wrappers around jose APIs using antithrow Result types",
	"license": "MIT",
	"author": "Jack Weilage",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/antithrow/antithrow.git",
		"directory": "packages/jose"
	},
	"homepage": "https://antithrow.dev",
	"bugs": {
		"url": "https://github.com/antithrow/antithrow/issues"
	},
	"keywords": [
		"antithrow",
		"result",
		"error-handling",
		"typescript",
		"type-safe",
		"jose",
		"jwt",
		"jws",
		"jwe",
		"jwk",
		"jwks"
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./jwt": {
			"types": "./dist/jwt/index.d.ts",
			"import": "./dist/jwt/index.js"
		},
		"./jws": {
			"types": "./dist/jws/index.d.ts",
			"import": "./dist/jws/index.js"
		},
		"./jwe": {
			"types": "./dist/jwe/index.d.ts",
			"import": "./dist/jwe/index.js"
		},
		"./key": {
			"types": "./dist/key/index.d.ts",
			"import": "./dist/key/index.js"
		},
		"./jwk": {
			"types": "./dist/jwk/index.d.ts",
			"import": "./dist/jwk/index.js"
		},
		"./jwks": {
			"types": "./dist/jwks/index.d.ts",
			"import": "./dist/jwks/index.js"
		},
		"./util": {
			"types": "./dist/util/index.d.ts",
			"import": "./dist/util/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist",
		"lint": "bun run lint:publint && bun run lint:types",
		"lint:publint": "publint",
		"lint:types": "tsc --noEmit"
	},
	"peerDependencies": {
		"antithrow": "workspace:^",
		"jose": "^6.0.0"
	},
	"devDependencies": {
		"antithrow": "workspace:^",
		"jose": "6.2.2"
	}
}
